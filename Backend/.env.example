# Server
PORT=5000
FRONTEND_URL=https://the-capstone-project-airbnb-frontend.onrender.com
NODE_ENV=development

# Database (MongoDB Atlas connection string)
MONGO_URI=mongodb+srv://<username>:<password>@cluster0.mongodb.net/airbnb-clone?retryWrites=true&w=majority

# Auth
JWT_SECRET=replace_this_with_a_long_random_string
JWT_EXPIRES_IN=7d
